// Pins doneram tracks in place of scripts/check_freshness.py. The weekly
// Freshness workflow patches these and opens a draft PR.

amends "package://github.com/kyleking/doneram/releases/download/v0.6.1/doneram@0.6.1#/Config.pkl"
import "package://github.com/kyleking/doneram/releases/download/v0.6.1/doneram@0.6.1#/Config.pkl"

/// uv owns the lock; doneram only raises the declared constraint.
afterPatch = "uv lock"


local downloadAssets = "scripts/download-assets.sh"
local editTemplate = "yak_shears/_templates/yak/edit.html.jinja"
local ciYaml = ".github/workflows/ci.yaml"
local freshnessYml = ".github/workflows/freshness.yml"
local miseToml = ".config/mise.toml"
local pyproject = "pyproject.toml"
local uvOutdated = #"(?P<name>[\w.\-]+) v(?P<current>[\w.\-]+)( \(latest: v?(?P<latest>[\w.\-]+)\))?"#

/// A mise tool pin, which yak-shears writes as `latest` until doneram
/// resolves it to the version that was current when it last ran.
local function misePin(key: String): Config.Site = new {
  file = miseToml
  pattern = #"\#(key) = "(latest|[\d.]+)""#
}

/// A `uses: owner/repo@<sha> # <tag>` GitHub Action pin, one capture group
/// spanning the sha and the tag together, since github-action patches both
/// as a single resolved value.
local function actionPin(action: String, sourceFile: String): Config.Site = new {
  file = sourceFile
  pattern = #"\#(action)@([0-9a-f]{40} # v[\w.]+)"#
}

tools = new {
  ["biome"] = new {
    resolver = "mise"
    resolverName = "npm:@biomejs/biome"
    sites = new { misePin(#""npm:@biomejs/biome""#) }
  }
  ["checkout"] = new {
    resolver = "github-action"
    resolverName = "actions/checkout"
    sites = new {
      actionPin("actions/checkout", ciYaml)
      actionPin("actions/checkout", freshnessYml)
    }
  }
  ["click"] = new {
    command = "uv tree --outdated"
    commandPattern = uvOutdated
  }
  ["codejar"] = new {
    resolver = "github-branch"
    resolverName = "antonmedv/codejar@master"
    sites = new { new Config.Site { file = downloadAssets; pattern = #"CODEJAR_VERSION:-([0-9a-f]{40})"# } }
  }
  ["create-github-app-token"] = new {
    resolver = "github-action"
    resolverName = "actions/create-github-app-token"
    sites = new { actionPin("actions/create-github-app-token", freshnessYml) }
  }
  ["create-pull-request"] = new {
    resolver = "github-action"
    resolverName = "peter-evans/create-pull-request"
    sites = new { actionPin("peter-evans/create-pull-request", freshnessYml) }
  }
  ["djot"] = new {
    resolver = "npm"
    resolverName = "@djot/djot"
    sites = new { new Config.Site { file = editTemplate; pattern = #"unpkg\.com/@djot/djot@([\d.]+)"# } }
  }
  ["doneram-schema"] = new {
    resolver = "github-release"
    resolverName = "kyleking/doneram"
    sites = new {
      new Config.Site {
        file = ".doneram.pkl"
        pattern = #"releases/download/v([\d.]+)/doneram"#
      }
      new Config.Site {
        file = ".doneram.pkl"
        pattern = #"doneram@([\d.]+)#/Config\.pkl"#
      }
    }
  }
  ["dprint"] = new {
    resolver = "mise"
    resolverName = "npm:dprint"
    sites = new { misePin(#""npm:dprint""#) }
  }
  ["doneram"] = new {
    resolver = "github-action"
    resolverName = "kyleking/doneram"
    sites = new { actionPin("kyleking/doneram", freshnessYml) }
  }
  ["doneram-version"] = new {
    resolver = "github-release"
    resolverName = "kyleking/doneram"
    sites = new { new Config.Site { file = freshnessYml; pattern = #"version: v([\d.]+)"# } }
  }
  ["htmx"] = new {
    resolver = "github-release"
    resolverName = "bigskysoftware/htmx"
    // TODO: drop this once the app is ported to htmx 4, which moved the
    // extension and swap APIs the templates use.
    pattern = "2.#.#"
    sites = new { new Config.Site { file = downloadAssets; pattern = #"HTMX_VERSION:-v([\d.]+)"# } }
  }
  ["idna"] = new {
    command = "uv tree --outdated"
    commandPattern = uvOutdated
  }
  ["mise-action"] = new {
    resolver = "github-action"
    resolverName = "jdx/mise-action"
    sites = new {
      actionPin("jdx/mise-action", ciYaml)
      actionPin("jdx/mise-action", freshnessYml)
    }
  }
  ["pkl"] = new {
    resolver = "mise"
    sites = new { misePin("pkl") }
  }
  ["prismjs"] = new {
    resolver = "npm"
    sites = new { new Config.Site { file = editTemplate; pattern = #"cdn\.jsdelivr\.net/npm/prismjs@([\d.]+)"#; expect = 3 } }
  }
  ["python"] = new {
    resolver = "mise"
    sites = new { misePin("python") }
  }
  ["setup-uv"] = new {
    resolver = "github-action"
    resolverName = "astral-sh/setup-uv"
    sites = new {
      actionPin("astral-sh/setup-uv", ciYaml)
      actionPin("astral-sh/setup-uv", freshnessYml)
    }
  }
  ["terser"] = new {
    resolver = "mise"
    resolverName = "npm:terser"
    sites = new { misePin(#""npm:terser""#) }
  }
  ["typescript"] = new {
    resolver = "mise"
    resolverName = "npm:typescript"
    sites = new { misePin(#""npm:typescript""#) }
  }
  ["upload-artifact"] = new {
    resolver = "github-action"
    resolverName = "actions/upload-artifact"
    sites = new { actionPin("actions/upload-artifact", ciYaml) }
  }
  ["uvicorn"] = new {
    command = "uv tree --outdated"
    commandPattern = uvOutdated
    sites = new { new Config.Site { file = pyproject; pattern = #""uvicorn>=([\d.]+)""# } }
  }
}
