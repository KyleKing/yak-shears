# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/research_platform
DATABASE_ECHO=false

# API Keys (at least one required)
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
GEMINI_API_KEY=...
GROQ_API_KEY=gsk_...

# Embedding Service
EMBEDDING_MODEL=openai:text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# Logfire (optional - for observability)
LOGFIRE_TOKEN=...
LOGFIRE_PROJECT=agent-research-platform
ENABLE_LOGFIRE=true

# Agent Configuration
DEFAULT_MODEL=openai:gpt-4
MAX_RETRIES=3
TIMEOUT_SECONDS=30

# Evaluation
EVAL_CACHE_ENABLED=true
EVAL_RECORD_MODE=once

# Feature Flags
ENABLE_COST_TRACKING=true
