{#def
yak_name: str
yak_path: str
content: str
category: str
category_color: str
frontmatter: dict[str, object]
backlinks: list[tuple[str, str]]
-#}
{% extends "base.html.jinja" %}

{% block extra_head %}
  <!-- freshness: npm prismjs -->
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/prismjs@1.30.0/themes/prism.min.css">
  <!-- freshness: npm @djot/djot -->
  <script src="https://unpkg.com/@djot/djot@0.3.2/dist/djot.js"></script>
  <script src="{{ static_url('js/codejar.min.js') }}"></script>
  <script src="{{ static_url('js/highlight.js') }}"></script>
  <script defer src="https://cdn.jsdelivr.net/npm/prismjs@1.30.0/prism.min.js"></script>
  <script defer src="https://cdn.jsdelivr.net/npm/prismjs@1.30.0/plugins/autoloader/prism-autoloader.min.js"></script>
{% endblock %}

{% block title %}Editing {{ yak_name }}{% endblock %}

{% block header_center %}{% endblock %}

{% block content %}
  {# Backdrop overlay - shown when metadata panel is open on mobile or unpinned desktop #}
  <div class="metadata-backdrop" id="metadata-backdrop"></div>

  <div class="editor-layout">
    <div class="editor-main">
      {# Draft recovery bar - unhidden by editor.js:_setupDraftToggle() when
         localStorage holds unsaved changes that differ from the server version #}
      <div class="draft-toggle" id="draft-toggle" hidden>
        <span class="draft-toggle__label">unsaved local changes</span>
        <button class="button button--sm active" type="button" id="draft-server-btn">server</button>
        <button class="button button--sm" type="button" id="draft-local-btn">local</button>
      </div>

      {# The note's identity used to live only inside the metadata panel, which
         ships closed, so the editor gave no sign of which yak was open. This
         plate is always visible. #}
      <div class="editor-head" style="--head-accent: {{ category_color }}">
        <span class="editor-head__cap" aria-hidden="true"></span>
        <span class="editor-head__name">{{ yak_name }}</span>
        <span class="editor-head__category">{{ category }}</span>
        <div class="view-toggle" role="group" aria-label="View mode">
          <button class="button button--sm" id="editor-only-btn" data-view="editor">editor</button>
          <button class="button button--sm" id="side-by-side-btn" data-view="side-by-side">split</button>
          <button class="button button--sm" id="preview-only-btn" data-view="preview">preview</button>
        </div>
      </div>

      <div class="editor-container" id="editor-container">
        {# Form wrapper required for HTMX POST - see handlers.py:edit_yak_handler #}
        <form id="editor-form" method="post">
          <input type="hidden" name="yak" value="{{ yak_path }}">
          {#
            CodeJar editor element
            - data-manual: Prevents auto-init (we control initialization timing)
            - data-gramm="false": Disables Grammarly browser extension interference
            Initialized in editor.js:initEditor()
          #}
          <div class="editor" data-manual data-gramm="false"></div>
        </form>

        {# Live preview pane - rendered from Djot via editor.js:renderPreview() #}
        <div class="preview" id="preview">
          <div class="preview-content" id="preview-content"></div>
        </div>
      </div>

      {# Command panel. Composes one instruction (a count, a scope, and a set of
         commands), applies it, and closes. It replaced a bar pinned above the
         keyboard, because that strip belongs to Safari's form assistant, which
         a page cannot measure, detect, or hide. See adr/0011. #}
      <div class="cmd" id="cmd" data-side="right" hidden>
        <button class="cmd__trigger" id="cmd-trigger" type="button" aria-expanded="false" aria-controls="cmd-panel" aria-label="Editor commands" title="Editor commands">
          <span class="cmd__trigger-mark" aria-hidden="true"></span>
        </button>

        <div class="cmd__panel" id="cmd-panel" role="group" aria-label="Editor commands" hidden>
          <div class="cmd__rack" role="group" aria-label="Repeat count">
            <span class="cmd__legend">count</span>
            {% for n in range(1, 6) %}
              <button class="cmd__count" type="button" data-count="{{ n }}" aria-pressed="{{ 'true' if n == 1 else 'false' }}">{{ n }}</button>
            {% endfor %}
          </div>

          {# Only has a say when nothing is selected: a selection is its own scope. #}
          <div class="cmd__rack" id="cmd-scope" role="group" aria-label="Target when nothing is selected">
            <span class="cmd__legend">scope</span>
            <button class="cmd__scope" type="button" data-scope="line" aria-pressed="true">line</button>
            <button class="cmd__scope" type="button" data-scope="word" aria-pressed="false">word</button>
          </div>

          {# data-repeats marks the commands a count multiplies. The rest stay
             tappable and ignore it, so no key ever goes dead. #}
          <div class="cmd__keys" role="group" aria-label="Commands">
            <button class="cmd__key" type="button" data-action="outdent" data-repeats aria-label="Outdent list item">&#8676;</button>
            <button class="cmd__key" type="button" data-action="indent" data-repeats aria-label="Indent list item">&#8677;</button>
            <button class="cmd__key" type="button" data-action="bullet" aria-label="Toggle bullet">&bull;</button>
            <button class="cmd__key" type="button" data-action="checklist" aria-label="Toggle checklist">&#9744;</button>
            <button class="cmd__key" type="button" data-action="bold" aria-label="Bold"><b>B</b></button>
            <button class="cmd__key" type="button" data-action="italic" aria-label="Italic"><i>I</i></button>
          </div>

          <div class="cmd__foot">
            <button class="cmd__compose" id="cmd-compose" type="button" aria-pressed="false">compose</button>
            <button class="cmd__apply" id="cmd-apply" type="button" hidden>apply</button>
            <button class="cmd__cancel" id="cmd-cancel" type="button">cancel</button>
          </div>
        </div>
      </div>

      {# Fixed bottom action bar with save button and status #}
      <div class="editor__actions">
        <div class="container">
          {# HTMX-powered save button - not inside #editor-form, so yak is supplied via hx-vals and editor.js injects content via htmx:configRequest #}
          <button class="button button--primary" id="save-btn" hx-post="/edit" hx-swap="none" hx-vals='{"yak": {{ yak_path | tojson }}}'>Save</button>
          <button class="button button--secondary" id="menu-btn" type="button" aria-label="Toggle menu" aria-expanded="false" aria-controls="metadata-panel" title="Toggle menu (⌘M)">Menu</button>
          {# Upload photo/video: inserts a Djot image snippet at the cursor. Also triggerable by pasting. #}
          <button class="button button--secondary" id="upload-btn" type="button" aria-label="Attach photo or video" title="Attach photo or video">＋ Media</button>
          <input type="file" id="media-input" accept="image/*,video/*" multiple hidden>
          {# Status indicator: "Synced" | "Modified" | "Saving..." | "Saved" #}
          <span id="save-status" class="editor__status"></span>
        </div>
      </div>
    </div>

    {# Metadata/properties sidebar - modal on mobile, pinnable on desktop.
       Styled as a terminal/TUI pane: a title bar with a category-colored
       powerline accent and status-bar-style section labels. #}
    <aside class="metadata-panel" id="metadata-panel" style="--panel-accent: {{ category_color }}">
      <div class="panel-titlebar">
        <span class="panel-titlebar__tab">
          <span class="panel-titlebar__mark" aria-hidden="true"></span>metadata
        </span>
        <span class="panel-titlebar__tri" aria-hidden="true">▶</span>
        {# Pin button (desktop only) - keeps panel open alongside editor #}
        <button
          class="panel-pin"
          type="button"
          id="panel-pin-btn"
          aria-label="Pin panel"
          aria-pressed="false"
        >
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path d="M9.5 1L10.5 2L9 5.5L12 8.5L11 14L8 11L5 14L4 8.5L7 5.5L5.5 2L6.5 1L8 3L9.5 1Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>
          </svg>
        </button>
      </div>

      <div class="panel-file">
        <span class="panel-file__name">{{ yak_name }}</span>
        <span class="panel-file__category">{{ category }}</span>
      </div>

      {# View mode toggle lives on the editor head plate (data-view values:
         "editor" | "side-by-side" | "preview", see editor.js:setViewMode). #}

      {# Word wrap toggle (2.5) - default off #}
      <section class="metadata-section">
        <div class="metadata-section__label">wrap</div>
        <button class="button button--sm wrap-toggle" type="button" id="wrap-toggle" aria-pressed="false">off</button>
      </section>

      {% if frontmatter %}
        <section class="metadata-section">
          <div class="metadata-section__label">props</div>
          <div class="metadata-properties">
            {% for key, value in frontmatter.items() %}
              <div class="metadata-property">
                <span class="metadata-property__key">{{ key }}</span>
                <span class="metadata-property__value">
                  {% if value is iterable and value is not string %}
                    {{ value | join(', ') }}
                  {% else %}
                    {{ value }}
                  {% endif %}
                </span>
              </div>
            {% endfor %}
          </div>
        </section>
      {% endif %}

      <section class="metadata-section">
        <div class="metadata-section__label">links {{ backlinks | length }}</div>
        {% if backlinks %}
          <ul class="backlinks-list">
            {% for source_path, link_type in backlinks %}
              <li class="backlink-item">
                <a href="/edit?yak={{ source_path }}" class="backlink-link">
                  {{ source_path }}
                </a>
                <span class="backlink-type">{{ link_type }}</span>
              </li>
            {% endfor %}
          </ul>
        {% else %}
          <p class="metadata-empty">No backlinks</p>
        {% endif %}
      </section>

      <section class="metadata-section metadata-section--danger">
        <button class="button button--sm button--danger-ghost button--full" hx-post="/delete" hx-vals='{"yak": {{ yak_path | tojson }}}' hx-confirm="Delete this yak? This cannot be undone.">rm {{ yak_name }}</button>
      </section>
    </aside>
  </div>
{% endblock %}

{% block scripts %}
  <script>
  window.serverContent = {{ content | tojson }};
  </script>
  <script type="module" src="{{ static_url('js/editor.js') }}"></script>
{% endblock %}
