{% extends "base.html.jinja" %}

{% block extra_head %}
  <script src="https://unpkg.com/@djot/djot@0.3.2/dist/djot.js"></script>
  <script src="/static/js/codejar.min.js"></script>
  <script src="/static/js/highlight.js"></script>
{% endblock %}

{% block title %}Editing {{ yak_name }}{% endblock %}

{% block header_center %}
  <span>Editing: {{ yak_name }}</span>
{% endblock %}

{% block content %}
  <div class="editor__header"></div>

  <form id="editor_form" method="post">
    <input type="hidden" name="yak" value="{{ yak_path }}">
    <div class="editor" data-manual data-gramm="false"></div>
  </form>

  <div class="editor__actions">
    <div class="container">
      <button class="button button--primary" id="save-btn" hx-post="/edit" hx-swap="none" hx-vals="js:{content: getEditorContent(), yak: '{{ yak_path }}'}">Save Changes</button>
      <span id="save-status" class="editor__status"></span>
    </div>
  </div>
{% endblock %}

{% block scripts %}
  <script>
  window.serverContent = {{ content | tojson }};
  </script>
  <script type="module" src="/static/js/editor.js"></script>
{% endblock %}
