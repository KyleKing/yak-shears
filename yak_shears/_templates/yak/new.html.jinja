{% extends "base.html.jinja" %}

{% block title %}New Yak{% endblock %}

{% block header_center %}
  <span>Creating New Yak</span>
{% endblock %}

{% block content %}
  <h1>Create New Yak</h1>

  <form method="post" class="form">
    <div class="form__group">
      <label for="category" class="form__label">Category:</label>
      <input type="text" id="category" name="category" class="form__input" list="category-options" placeholder="Pick or type a category" autocomplete="off" autofocus required>
      <datalist id="category-options">
        {% for cat in categories | sort %}
          <option value="{{ cat }}"></option>
        {% endfor %}
      </datalist>
    </div>

    <div class="form__actions">
      <button type="submit" class="button button--primary">Create Yak</button>
      <a href="/yaks" class="button">Cancel</a>
    </div>
  </form>
{% endblock %}
