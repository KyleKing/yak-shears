{% extends "base.html.jinja" %}

{% block title %}New Yak{% endblock %}

{% block header_center %}
  <span>Creating New Yak</span>
{% endblock %}

{% block content %}
  <h1>Create New Yak</h1>

  <form method="post" class="form">
    <div class="form__group">
      <label for="category" class="form__label">Category:</label>
      <div class="combobox" data-combobox>
        <input type="text" id="category" name="category" class="form__input combobox__input" placeholder="Pick or type a category" autocomplete="off" autofocus required role="combobox" aria-expanded="false" aria-autocomplete="list" aria-controls="category-listbox">
        <ul class="combobox__list" id="category-listbox" role="listbox" hidden>
          {% for cat in categories | sort %}
            <li class="combobox__option" id="category-option-{{ loop.index }}" role="option" data-value="{{ cat }}">{{ cat }}</li>
          {% endfor %}
        </ul>
      </div>
    </div>

    <div class="form__actions">
      <button type="submit" class="button button--primary">Create Yak</button>
      <a href="/yaks" class="button">Cancel</a>
    </div>
  </form>
{% endblock %}

{% block scripts %}
  <script src="{{ static_url('js/combobox.js') }}"></script>
{% endblock %}
