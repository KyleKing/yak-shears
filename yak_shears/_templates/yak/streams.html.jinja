{#def
from collections.abc import Mapping
from yak_shears._yak.streams import StreamInfo, TaskInfo, UndoInfo
streams: list[StreamInfo]
focused: StreamInfo | None
triage: list[TaskInfo]
category_colors: Mapping[str, str]
undo: UndoInfo | None = None
current_route: str = "streams"
-#}
{% extends "base.html.jinja" %}

{% block title %}Streams{% endblock %}

{% block extra_head %}
  {# Prototype-only styles, inlined so the throwaway route leaves main.css and
     its budget untouched. Promote into main.css if the view graduates. #}
  <style>
    .streams { margin: 0 auto; }
    /* The dock is a pull-down tray: closed it is one bar naming the focused
       stream, open it drops the full meter bank. Same control at every width. */
    .tray { margin-bottom: 1.5rem; }
    .tray__bar {
      display: flex; align-items: center; gap: 0.75rem;
      min-height: var(--tap-target);
      padding: 0 1rem 0 0;
      background: var(--panel-raised); background-image: var(--anodize);
      border-radius: var(--radius-sm);
      box-shadow: inset 0 1px 0 var(--engrave-light), 0 1px 1px rgba(0, 0, 0, 0.12);
      cursor: pointer; list-style: none;
    }
    .tray__bar::-webkit-details-marker { display: none; }
    .tray[open] .tray__bar { border-radius: var(--radius-sm) var(--radius-sm) 0 0; }
    .tray__label { font-size: 0.75rem; font-weight: 600; letter-spacing: 0.09em; text-transform: uppercase; color: var(--legend-dim); }
    .tray__name { font-size: 0.9375rem; font-weight: 600; }
    .tray__stats { margin-left: auto; display: flex; align-items: center; gap: 1rem; }
    .tray__chevron {
      width: 8px; height: 8px; flex: none;
      border-right: 2px solid var(--legend-dim); border-bottom: 2px solid var(--legend-dim);
      transform: rotate(45deg) translateY(-1px);
      transition: transform var(--throw);
    }
    .tray[open] .tray__chevron { transform: rotate(225deg) translateY(-1px); }
    .tray__bank {
      background: var(--well); box-shadow: var(--inset-well);
      border-radius: 0 0 var(--radius-sm) var(--radius-sm);
      padding: 1rem;
      display: flex; flex-direction: column; gap: 1rem;
    }
    .tray__cat { display: flex; align-items: center; gap: 0.5rem; margin-bottom: 0.5rem; }
    .tray__catdot { width: 10px; height: 6px; border-radius: 1px; }
    .tray__catname { font-size: 0.6875rem; font-weight: 600; letter-spacing: 0.11em; text-transform: uppercase; color: var(--legend-dim); }
    .tray__meters { display: grid; grid-template-columns: repeat(auto-fill, minmax(11rem, 1fr)); gap: 0.5rem; }
    .mark { display: flex; align-self: stretch; }
    .mark__cat { width: 8px; box-shadow: inset 1px 0 0 rgba(255, 255, 255, 0.22); }
    .mark__stream { width: 5px; }
    .meter {
      display: grid; grid-template-columns: auto minmax(0, 1fr) auto; gap: 0 0.6rem;
      align-items: stretch; min-height: var(--tap-target);
      background: var(--panel-raised); background-image: var(--anodize);
      border-radius: var(--radius-sm);
      box-shadow: inset 0 1px 0 var(--engrave-light), 0 1px 1px rgba(0, 0, 0, 0.12);
      color: inherit; text-decoration: none;
      transition: background var(--throw), box-shadow var(--throw);
      overflow: hidden;
    }
    .meter:hover { background: var(--panel); }
    .meter--focused { background: var(--well); box-shadow: var(--inset-well), inset 0 -2px 0 var(--color-accent); }
    .meter__body { padding: 0.4rem 0; min-width: 0; }
    .meter__name {
      display: block; font-size: 0.625rem; font-weight: 600; letter-spacing: 0.1em;
      text-transform: uppercase; color: var(--legend);
      white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
    }
    .meter__flow { display: flex; align-items: flex-end; gap: 3px; height: 14px; margin-top: 0.3rem; }
    .meter__seg { width: 14px; border-radius: 1px; }
    .meter__lamp { align-self: center; padding-right: 0.75rem; display: flex; }
    .lamp { width: 7px; height: 7px; border-radius: var(--radius-pill); background: var(--lamp-off); flex: none; }
    .lamp--warn { background: var(--lamp-warn); box-shadow: 0 0 6px color-mix(in srgb, var(--lamp-warn) 55%, transparent); }
    .lamp--recency-live { width: 9px; height: 9px; background: var(--lamp-live); box-shadow: 0 0 6px color-mix(in srgb, var(--lamp-live) 55%, transparent); }
    .lamp--recency-recent { background: color-mix(in srgb, var(--lamp-live) 70%, var(--lamp-off)); }
    .lamp--recency-idle { width: 5px; height: 5px; background: color-mix(in srgb, var(--lamp-live) 30%, var(--lamp-off)); }
    .lamp--recency-cold { width: 4px; height: 4px; }
    .canal__head {
      display: grid; grid-template-columns: auto minmax(0, 1fr) auto; gap: 0 0.75rem;
      align-items: center; min-height: 3.25rem; margin-bottom: 1px;
      background: var(--panel-raised); background-image: var(--anodize);
    }
    .canal__key { font-size: 0.625rem; font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase; color: var(--legend-dim); display: block; }
    .canal__name { font-size: 0.9375rem; font-weight: 600; }
    .canal__stats { display: flex; align-items: center; gap: 1rem; padding-right: 1rem; }
    .canal__stat { display: flex; align-items: center; gap: 0.5rem; font-size: 0.6875rem; font-weight: 600; letter-spacing: 0.11em; text-transform: uppercase; color: var(--legend-dim); }
    .canal__stat-value { font-family: var(--font-signal); font-size: 0.8125rem; font-variant-numeric: tabular-nums; color: var(--legend); }
    .canal__stat-value--warn { color: var(--lamp-warn); }
    .canal__reach { background: var(--well); box-shadow: var(--inset-well); }
    .canal__sill {
      display: flex; align-items: center; gap: 0.75rem; padding: 0.35rem 1rem;
      border-top: 1px solid var(--engrave-light); border-bottom: 1px solid var(--engrave);
      background: var(--panel); background-image: var(--anodize);
      font-size: 0.6875rem; font-weight: 600; letter-spacing: 0.11em; text-transform: uppercase; color: var(--legend-dim);
    }
    .canal__sill-count { margin-left: auto; font-family: var(--font-signal); font-variant-numeric: tabular-nums; }
    .canal__strip {
      display: grid; grid-template-columns: 2.25rem auto minmax(0, 1fr) 2.5rem 7.5rem 1.5rem; gap: 0 0.75rem;
      align-items: center; height: 3.25rem;
      background: var(--panel-raised); background-image: var(--anodize);
      /* Clears the sticky deck when J/K scrolls a latched strip into view. */
      scroll-margin-bottom: 13rem;
    }
    /* The latch: a recessed socket at the strip's head. Latching a strip arms
       it as the target the deck's keys fire on, so checked reads armed amber. */
    .canal__latchcell { display: flex; align-items: center; justify-content: center; align-self: stretch; cursor: pointer; }
    .latch {
      appearance: none; margin: 0; width: 14px; height: 14px; flex: none;
      border-radius: var(--radius-pill); background: var(--well);
      box-shadow: var(--inset-well); cursor: pointer;
    }
    .latch:checked { background: var(--color-accent); box-shadow: var(--inset-well), inset 0 0 0 3px var(--well); }
    .latch:focus-visible { outline: 2px solid var(--color-accent); outline-offset: 2px; }
    .canal__strip:has(.latch:checked) {
      background: var(--well); background-image: none;
      box-shadow: var(--inset-well), inset 0 -2px 0 var(--color-accent);
    }
    .canal__strip + .canal__strip { margin-top: 1px; }
    .canal__strip--waiting .canal__title, .canal__strip--waiting .canal__due { opacity: 0.55; }
    .canal__title {
      font-size: 0.9375rem; font-weight: 600; line-height: 1.35;
      white-space: nowrap; overflow: hidden; text-overflow: ellipsis; padding-right: 0.5rem;
      color: inherit; text-decoration: none;
    }
    .canal__title small { display: block; font-size: 0.875rem; font-weight: 400; color: var(--legend-dim); }
    .canal__rel { font-family: var(--font-signal); font-size: 0.8125rem; font-variant-numeric: tabular-nums; color: var(--legend-dim); text-align: right; }
    .canal__due { font-family: var(--font-signal); font-size: 0.8125rem; font-variant-numeric: tabular-nums; color: var(--legend-dim); text-align: right; }
    .canal__due--pressing { color: var(--lamp-warn); }
    .canal__due--overdue { color: var(--lamp-fault); }
    .canal__lampcell { display: flex; justify-content: center; padding-right: 0.5rem; }
    .canal__empty { padding: 0.75rem 1rem; font-size: 0.875rem; color: var(--legend-dim); }
    /* The command deck: a sticky panel of keys that surfaces once a strip is
       latched. One instruction per press, ADR 0011's grammar brought to the
       board; every binding is printed on its key. */
    .deck {
      display: none;
      position: sticky; bottom: 0; z-index: 2;
      margin-top: 1.5rem; padding: 0.75rem 1rem calc(0.75rem + env(safe-area-inset-bottom, 0px));
      background: var(--panel-raised); background-image: var(--anodize);
      border-radius: var(--radius-sm) var(--radius-sm) 0 0;
      box-shadow: inset 0 1px 0 var(--engrave-light), 0 -4px 12px rgba(0, 0, 0, 0.25);
    }
    .board:has(.latch:checked) .deck { display: flex; flex-wrap: wrap; gap: 1rem 1.75rem; align-items: end; }
    .deck__group { display: flex; flex-direction: column; gap: 0.35rem; }
    .deck__group[hidden] { display: none; }
    .deck__legend { font-size: 0.625rem; font-weight: 600; letter-spacing: 0.11em; text-transform: uppercase; color: var(--legend-dim); }
    .deck__keys { display: flex; gap: 0.5rem; flex-wrap: wrap; align-items: center; }
    .deck__key {
      display: inline-flex; align-items: center; justify-content: center; gap: 0.4rem;
      min-height: var(--tap-target); padding: 0 0.75rem;
      background: var(--panel-raised);
      border: 1px solid var(--engrave); border-radius: var(--radius-sm);
      box-shadow: inset 0 1px 0 var(--engrave-light), 0 1px 1px rgba(0, 0, 0, 0.12);
      font-family: var(--font-legend); font-size: 0.6875rem; font-weight: 600;
      letter-spacing: 0.09em; text-transform: uppercase; color: var(--legend);
      cursor: pointer; white-space: nowrap;
      transition: background var(--throw), transform var(--throw), box-shadow var(--throw);
    }
    .deck__key:hover { background: var(--panel); }
    .deck__key:active { transform: translateY(1px); box-shadow: var(--inset-well); }
    /* The deck's one armed key: Raise wears the amber face, everything else
       stays a plain key. */
    .deck__key--raise {
      background: var(--color-accent); color: #1b1206;
      border-color: color-mix(in srgb, var(--color-accent) 70%, #000);
      box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.45), 0 1px 1px rgba(0, 0, 0, 0.18);
    }
    .deck__key--raise:hover { background: color-mix(in srgb, var(--color-accent) 88%, #fff); }
    .deck__key--raise kbd { color: #1b1206; border-color: rgba(0, 0, 0, 0.35); }
    /* Bindings only exist once the script wires them, so their caps and the
       hint stay hidden until .board--keys lands. */
    .deck__key kbd {
      display: none;
      font-family: var(--font-signal); font-size: 0.625rem; font-weight: 400;
      color: var(--legend-dim); border: 1px solid var(--engrave);
      border-radius: 2px; padding: 0 0.25rem; line-height: 1.4;
    }
    .board--keys .deck__key kbd { display: inline-block; }
    /* Non-JS baseline: Enter in the reason field must mean Wait, not the
       form's first key, so an invisible default submit precedes the Gate group. */
    .deck__default {
      position: absolute; width: 1px; height: 1px; overflow: hidden;
      clip-path: inset(50%); border: 0; padding: 0;
    }
    .deck__reason, .deck__select {
      min-height: var(--tap-target); padding: 0 0.6rem;
      background: var(--well); box-shadow: var(--inset-well);
      border: none; border-radius: var(--radius-sm);
      font-size: 0.8125rem; color: inherit;
    }
    .deck__reason { width: 9rem; }
    .deck__reason::placeholder { color: var(--legend-dim); }
    .deck__hint { display: none; font-size: 0.625rem; letter-spacing: 0.09em; text-transform: uppercase; color: var(--legend-dim); margin-left: auto; align-self: center; }
    .board--keys .deck__hint { display: inline; }
    /* The undo toast: the last write's inverse, one press away. */
    .toast {
      display: flex; align-items: center; gap: 0.75rem;
      margin-bottom: 1rem; padding: 0 0.35rem 0 1rem; min-height: var(--tap-target);
      background: var(--panel-raised); background-image: var(--anodize);
      border-radius: var(--radius-sm);
      box-shadow: inset 0 1px 0 var(--engrave-light), 0 1px 1px rgba(0, 0, 0, 0.12);
    }
    .toast__label { font-size: 0.8125rem; color: var(--legend); }
    .toast__label b { font-family: var(--font-signal); font-weight: 400; }
    .toast__key { margin-left: auto; }
    @media (max-width: 768px) {
      .board--keys .deck__key kbd, .board--keys .deck__hint { display: none; }
    }
    .streams-triage { margin-top: 2rem; }
    .streams-triage__legend { font-size: 0.8125rem; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; margin: 0 0 0.75rem; }
    /* Terminology explainer: same details mechanics as the tray, printed small. */
    .help { margin-top: 2.5rem; }
    .help__bar {
      display: inline-flex; align-items: center; gap: 0.5rem;
      min-height: var(--tap-target); padding: 0 0.25rem;
      font-size: 0.6875rem; font-weight: 600; letter-spacing: 0.11em; text-transform: uppercase;
      color: var(--legend-dim); cursor: pointer; list-style: none;
    }
    .help__bar::-webkit-details-marker { display: none; }
    .help__bar:hover { color: var(--legend); }
    .help dl {
      margin: 0.5rem 0 0; padding: 1rem 1.25rem;
      background: var(--well); box-shadow: var(--inset-well); border-radius: var(--radius-sm);
      display: grid; grid-template-columns: 7rem minmax(0, 1fr); gap: 0.5rem 1rem;
      font-size: 0.875rem; color: var(--legend-dim);
    }
    .help dt { font-size: 0.6875rem; font-weight: 600; letter-spacing: 0.11em; text-transform: uppercase; color: var(--legend); align-self: baseline; }
    .help dd { margin: 0; }
    @media (max-width: 768px) {
      .canal__strip { grid-template-columns: 2.25rem auto minmax(0, 1fr) 7.5rem 1.5rem; }
      .canal__rel { display: none; }
    }
  </style>
{% endblock %}

{% block content %}
  <div class="streams">
    <details class="tray">
      <summary class="tray__bar">
        {% if focused %}
          <span class="mark" aria-hidden="true">
            <span class="mark__cat" style="background: {{ category_colors.get(focused.category, 'var(--color-border)') }}"></span>
            <span class="mark__stream" style="background: {{ focused.color }}"></span>
          </span>
          <span class="tray__label">Stream</span>
          <span class="tray__name">{{ focused.name }}</span>
        {% else %}
          <span class="tray__label" style="padding-left: 1rem">Streams</span>
        {% endif %}
        <span class="tray__stats">
          <span class="canal__stat">{{ streams | length }} streams</span>
          <span class="tray__chevron" aria-hidden="true"></span>
        </span>
      </summary>
      <div class="tray__bank">
        {% for category, group in streams | groupby("category") %}
          <div>
            <div class="tray__cat">
              <span class="tray__catdot" style="background: {{ category_colors.get(category, 'var(--color-border)') }}"></span>
              <span class="tray__catname">{{ category or "uncategorized" }}</span>
            </div>
            <div class="tray__meters">
              {% for stream in group %}
                <a class="meter{% if focused and stream.key == focused.key %} meter--focused{% endif %}"
                   href="/streams?stream={{ stream.key | urlencode }}">
                  <span class="mark" aria-hidden="true">
                    <span class="mark__cat" style="background: {{ category_colors.get(stream.category, 'var(--color-border)') }}"></span>
                    <span class="mark__stream" style="background: {{ stream.color }}"></span>
                  </span>
                  <span class="meter__body">
                    <span class="meter__name">{{ stream.name }}</span>
                    <span class="meter__flow">
                      {% for state in ["backlog", "queue", "in-progress"] %}
                        {% set count = stream.reaches[state] | length %}
                        <span class="meter__seg"
                              style="height: {{ [2 + count * 3, 14] | min }}px; background: color-mix(in srgb, {{ stream.color }} {{ {'backlog': '28%', 'queue': '55%', 'in-progress': '85%'}[state] }}, {{ 'white' if state == 'in-progress' else 'var(--panel)' }})"></span>
                      {% endfor %}
                    </span>
                  </span>
                  <span class="meter__lamp"><span class="lamp{% if stream.over_wip %} lamp--warn{% endif %}"></span></span>
                </a>
              {% endfor %}
            </div>
          </div>
        {% endfor %}
      </div>
    </details>

    <main>
      {# Direction contract: the board's writes ride a command deck, ADR 0011's
         one-instruction grammar mounted on the canal. Latch a strip (armed
         amber), press a key, the write lands and the toast offers its inverse.
         Zero-JS baseline: radio latch + form post; JS adds bindings and repeat. #}
      {% if undo %}
        <form class="toast" method="post" action="/streams/act" role="status" aria-live="polite">
          <input type="hidden" name="path" value="{{ undo.path }}">
          <input type="hidden" name="lease:{{ undo.path }}" value="{{ undo.lease }}">
          <input type="hidden" name="action" value="{{ undo.action }}">
          {% if undo.reason %}<input type="hidden" name="reason" value="{{ undo.reason }}">{% endif %}
          <input type="hidden" name="focus" value="{{ focused.key if focused else '' }}">
          <span class="toast__label">Applied: <b>{{ undo.label }}</b></span>
          <button type="submit" class="deck__key toast__key">Undo</button>
        </form>
      {% endif %}
      <form class="board" method="post" action="/streams/act">
      <input type="hidden" name="focus" value="{{ focused.key if focused else '' }}">
      <button type="submit" class="deck__default" name="action" value="waiting" tabindex="-1" aria-hidden="true"></button>
      {% if focused %}
        <header class="canal__head">
          <span class="mark" aria-hidden="true">
            <span class="mark__cat" style="background: {{ category_colors.get(focused.category, 'var(--color-border)') }}"></span>
            <span class="mark__stream" style="background: {{ focused.color }}"></span>
          </span>
          <span>
            <span class="canal__key">{{ focused.key }}</span>
            <span class="canal__name">{{ focused.name }}</span>
          </span>
          <span class="canal__stats">
            <span class="canal__stat">Drained <span class="canal__stat-value">{{ focused.drained }}</span></span>
            <span class="canal__stat">WIP
              <span class="canal__stat-value{% if focused.over_wip %} canal__stat-value--warn{% endif %}">{{ focused.wip }}{% if focused.wip_limit %}/{{ focused.wip_limit }}{% endif %}</span>
            </span>
            {% if focused.over_wip %}<span class="lamp lamp--warn"></span>{% endif %}
          </span>
        </header>
        {% for state in ["in-progress", "queue", "backlog"] %}
          <div class="canal__reach">
            <div class="canal__sill">
              <span>{{ state.replace("-", " ") }}</span>
              <span class="canal__sill-count">{{ focused.reaches[state] | length }}</span>
            </div>
            {% for task in focused.reaches[state] %}
              <div class="canal__strip{% if task.waiting %} canal__strip--waiting{% endif %}">
                <label class="canal__latchcell">
                  <input class="latch" type="radio" name="path" value="{{ task.path }}" aria-label="Latch {{ task.title }}">
                  <input type="hidden" name="lease:{{ task.path }}" value="{{ task.lease }}">
                </label>
                <span class="mark" aria-hidden="true">
                  <span class="mark__cat" style="background: {{ category_colors.get(focused.category, 'var(--color-border)') }}"></span>
                  <span class="mark__stream" style="background: {{ focused.color }}"></span>
                </span>
                <a class="canal__title" href="/edit?path={{ task.path | urlencode }}">{{ task.title }}
                  {%- if task.waiting %}<small>waiting: {{ task.waiting }}</small>{% endif -%}
                </a>
                <span class="canal__rel" {% if task.relations %}title="{{ task.relations }} linked task(s)"{% endif %}>
                  {{- task.relations if task.relations else "" -}}
                </span>
                <span class="canal__due{% if task.urgency in ('pressing', 'overdue') %} canal__due--{{ task.urgency }}{% endif %}">
                  {{- task.due or "—" }}{% if task.flex %} +{{ task.flex }}{% endif -%}
                </span>
                <span class="canal__lampcell"><span class="lamp lamp--recency-{{ task.recency }}" title="modified: {{ task.recency }}"></span></span>
              </div>
            {% endfor %}
            {# A separate guard rather than for-else: typed-jinja's stub emits an
               empty else block when the branch holds no expressions. #}
            {% if not focused.reaches[state] %}
              <p class="canal__empty">Empty reach</p>
            {% endif %}
          </div>
        {% endfor %}
      {% else %}
        <p class="canal__empty">No stream notes yet. A stream is a note with <code>type: stream</code>, an <code>id</code>, and a <code>name</code>; a task is a note with <code>state</code> and <code>stream</code>.</p>
      {% endif %}

      {% if triage %}
        <section class="streams-triage">
          <h1 class="streams-triage__legend">Triage <span class="canal__sill-count">{{ triage | length }}</span></h1>
          {% for task in triage %}
            <div class="canal__strip">
              <label class="canal__latchcell">
                <input class="latch" type="radio" name="path" value="{{ task.path }}" aria-label="Latch {{ task.title }}">
                  <input type="hidden" name="lease:{{ task.path }}" value="{{ task.lease }}">
              </label>
              <span class="mark" aria-hidden="true">
                <span class="mark__cat" style="background: var(--lamp-off)"></span>
                <span class="mark__stream"></span>
              </span>
              <a class="canal__title" href="/edit?path={{ task.path | urlencode }}">{{ task.title }}
                <small>no stream &middot; {{ task.state }}</small>
              </a>
              <span class="canal__rel"></span>
              <span class="canal__due">{{ task.due or "—" }}</span>
              <span class="canal__lampcell"><span class="lamp lamp--recency-{{ task.recency }}"></span></span>
            </div>
          {% endfor %}
        </section>
      {% endif %}

      <div class="deck" role="group" aria-label="Command deck">
        <div class="deck__group">
          <span class="deck__legend">Gate</span>
          <div class="deck__keys">
            <button type="submit" class="deck__key deck__key--raise" name="action" value="advance">Raise <kbd>R</kbd></button>
            <button type="submit" class="deck__key" name="action" value="lower">Lower <kbd>L</kbd></button>
            <button type="submit" class="deck__key" name="action" value="state:not-planned">Not planned <kbd>N</kbd></button>
          </div>
        </div>
        <div class="deck__group">
          <span class="deck__legend">Due</span>
          <div class="deck__keys">
            <button type="submit" class="deck__key" name="action" value="due:today">Today <kbd>T</kbd></button>
            <button type="submit" class="deck__key" name="action" value="due:+1d">+1d <kbd>1</kbd></button>
            <button type="submit" class="deck__key" name="action" value="due:+7d">+7d <kbd>7</kbd></button>
            <button type="submit" class="deck__key" name="action" value="due:-1d">&minus;1d <kbd>-</kbd></button>
            <button type="submit" class="deck__key" name="action" value="due:clear">Clear <kbd>C</kbd></button>
          </div>
        </div>
        <div class="deck__group">
          <span class="deck__legend">Waiting</span>
          <div class="deck__keys">
            <input class="deck__reason" name="reason" placeholder="waiting on&hellip;" maxlength="80" aria-label="Waiting reason">
            <button type="submit" class="deck__key" name="action" value="waiting">Wait / reopen <kbd>W</kbd></button>
          </div>
        </div>
        <div class="deck__group">
          <span class="deck__legend">Stream</span>
          <div class="deck__keys">
            <select class="deck__select" name="to" aria-label="Target stream">
              {% for stream in streams %}
                <option value="{{ stream.key }}">{{ stream.key }}</option>
              {% endfor %}
              <option value="clear">none (triage)</option>
            </select>
            <button type="submit" class="deck__key" name="action" value="stream">Move <kbd>M</kbd></button>
          </div>
        </div>
        <div class="deck__group" hidden data-repeat-group>
          <span class="deck__legend">Repeat</span>
          <div class="deck__keys">
            <button type="button" class="deck__key" data-repeat><span></span> <kbd>.</kbd></button>
          </div>
        </div>
        <span class="deck__hint">J / K move the latch &middot; Enter raises &middot; Esc releases</span>
      </div>
      </form>

      <details class="help">
        <summary class="help__bar">Terminology</summary>
        <dl>
          <dt>Stream</dt><dd>A durable thread of related work. A note with <code>type: stream</code>; tasks name it by <code>category/id</code>.</dd>
          <dt>Reach</dt><dd>One section of the canal, holding every task in one state. Work flows upward: backlog, queue, in progress.</dd>
          <dt>Sill</dt><dd>The bar between reaches. Moving a task across a sill is a state change.</dd>
          <dt>Waiting</dt><dd>A task holding for something external (<code>waiting:</code> in its frontmatter). It stays in its reach, dimmed, with the reason printed.</dd>
          <dt>WIP</dt><dd>Tasks in progress right now. Over the stream's <code>wip-limit</code>, the lamp goes amber. Nothing blocks.</dd>
          <dt>Drained</dt><dd>Tasks that left the canal: complete or not planned.</dd>
          <dt>Due +n</dt><dd>The deadline, plus days of acceptable slip (<code>flex</code>). Amber inside the flex window, red past it.</dd>
          <dt>Lamp</dt><dd>The small dot at the row's end reports how recently the note changed: bigger and brighter is fresher.</dd>
          <dt>Triage</dt><dd>Task notes with no stream, or naming one that does not exist.</dd>
        </dl>
      </details>
    </main>
  </div>
  <script>
    (() => {
      "use strict";
      const board = document.querySelector(".board");
      if (!board) { return; }
      board.classList.add("board--keys");
      const latches = Array.from(board.querySelectorAll(".latch"));
      const bindings = {
        r: "advance", l: "lower", n: "state:not-planned",
        t: "due:today", 1: "due:+1d", 7: "due:+7d", "-": "due:-1d", c: "due:clear",
        w: "waiting", m: "stream",
      };
      const press = (action) => {
        const key = board.querySelector(`.deck [name="action"][value="${action}"]`);
        if (key) { key.click(); }
      };

      const repeatGroup = board.querySelector("[data-repeat-group]");
      const repeatKey = board.querySelector("[data-repeat]");
      let last = null;
      try { last = JSON.parse(sessionStorage.getItem("board-last") || "null"); } catch { /* stale */ }
      if (last && last.action) {
        repeatGroup.hidden = false;
        repeatKey.querySelector("span").textContent = last.action === "stream" ? `stream ${last.to}` : last.action.replace(":", " ");
      }
      const repeat = () => {
        if (!last || !last.action) { return; }
        const reason = board.querySelector('[name="reason"]');
        const to = board.querySelector('[name="to"]');
        if (reason && last.reason) { reason.value = last.reason; }
        if (to && last.to) { to.value = last.to; }
        press(last.action);
      };
      repeatKey.addEventListener("click", repeat);

      board.addEventListener("submit", (event) => {
        const action = event.submitter && event.submitter.value;
        if (!action) { return; }
        sessionStorage.setItem("board-last", JSON.stringify({
          action,
          reason: (board.querySelector('[name="reason"]') || {}).value || "",
          to: (board.querySelector('[name="to"]') || {}).value || "",
        }));
      });

      document.addEventListener("keydown", (event) => {
        if (event.metaKey || event.ctrlKey || event.altKey) { return; }
        if (event.target.closest("input:not(.latch), select, textarea")) { return; }
        const key = event.key.toLowerCase();
        if (key === "escape") {
          latches.forEach((latch) => { latch.checked = false; });
          return;
        }
        if (key === "j" || key === "k") {
          const index = latches.findIndex((latch) => latch.checked);
          const next = (index < 0) ? 0 : Math.min(latches.length - 1, Math.max(0, index + (key === "j" ? 1 : -1)));
          if (latches[next]) {
            latches[next].checked = true;
            latches[next].scrollIntoView({ block: "nearest" });
          }
          event.preventDefault();
          return;
        }
        if (!latches.some((latch) => latch.checked)) { return; }
        if (key === "enter") { press("advance"); event.preventDefault(); return; }
        if (key === ".") { repeat(); event.preventDefault(); return; }
        if (bindings[key]) { press(bindings[key]); event.preventDefault(); }
      });
    })();
  </script>
{% endblock %}
