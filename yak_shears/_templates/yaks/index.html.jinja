{#def
from yak_shears._templates import YakInfo, SortBy
from collections.abc import Callable
yaks: list[YakInfo]
current_page: int
total_pages: int
total_yaks: int
yak_dir_label: str
sort_by: SortBy
current_category: str | None
categories: set[str]
get_category_color: Callable[[str], str]
show_new: bool
-#}
{% extends "base.html.jinja" %}

{% block title %}Yaks in {{ yak_dir_label }}{% endblock %}

{% block extra_head %}
  <script src="https://unpkg.com/@djot/djot@0.3.2/dist/djot.js"></script>
{% endblock %}

{% block content %}
  <div class="yaks-head">
    <h1 class="yaks-head__title">Vault <span class="yaks-head__path">{{ yak_dir_label }}</span></h1>
    <p class="page-info">{{ yaks | length }} of {{ total_yaks }} yaks &middot; page {{ current_page }} of {{ total_pages }}</p>
  </div>

  {# Two rows of chips ate most of a phone screen before the first card. A
     <details> collapses them behind a one-line summary of what is active. It
     ships open and nav.js closes it on phones, because a closed <details>
     hides its content with content-visibility that CSS cannot force open. #}
  <details class="yaks-controls" id="yaks-controls" open>
    <summary class="yaks-controls__toggle">
      <span class="yaks-controls__current">
        {{ 'Created' if sort_by == 'created_at' else 'Modified' }}
        &middot;
        {{ current_category | title if current_category else 'All' }}
      </span>
      <span class="yaks-controls__caret" aria-hidden="true">&#9662;</span>
    </summary>

    <div class="yaks-controls__panel">
      <div class="sort-controls">
        <span class="sort-controls__label">Sort by:</span>
        <a href="/yaks?sort_by=created_at{% if current_category %}&category={{ current_category }}{% endif %}" class="button button--sm {% if sort_by == 'created_at' %}button--primary{% endif %}">Created At</a>
        <a href="/yaks?sort_by=modified_date{% if current_category %}&category={{ current_category }}{% endif %}" class="button button--sm {% if sort_by == 'modified_date' %}button--primary{% endif %}">Modified Date</a>
      </div>

      {% if categories %}
        <div class="filter-controls">
          <span class="filter-controls__label">Filter by category:</span>
          <a href="/yaks?sort_by={{ sort_by }}" class="button button--sm {% if not current_category %}button--primary{% endif %}">All</a>
          {% for cat in categories | sort %}
            <a href="/yaks?sort_by={{ sort_by }}&category={{ cat }}" class="button button--sm {% if current_category == cat %}button--primary{% endif %}">{{ cat | title }}</a>
          {% endfor %}
        </div>
      {% endif %}
    </div>
  </details>

  {% if yaks %}
    <div class="cards">
      {% for info in yaks %}
        <a href="/edit?yak={{ info.path }}" class="card" style="--card-accent-color: {{ get_category_color(info.category) }}">
          <span class="card__cap" aria-hidden="true"></span>
          <div class="card__body">
            <div class="card__preview" data-src="{{ info.preview }}">{{ info.preview }}{% if info.truncated %}…{% endif %}</div>
            {% if info.tags %}
              <div class="card__tags">
                {% for tag in info.tags %}<span class="card__tag">{{ tag }}</span>{% endfor %}
              </div>
            {% endif %}
          </div>
          <div class="card__meta">
            {# The cap already states the category in color. The name is here for
               anyone who has not learned the palette yet and for screen readers,
               and fades in on hover rather than spending a column on every row.
               Opacity, not display, so it stays in the accessibility tree. #}
            <span class="card__chip">{{ info.category }}</span>
            <span class="card__stat card__stat--date" title="Last modified">{{ info.last_modified[:10] }}</span>
            <span class="card__signal">
              <span class="card__lamp card__lamp--{{ info.recency }}" title="Edited {{ info.last_modified[:10] }}" aria-hidden="true"></span>
              <span class="card__stat card__stat--links" data-patched="{{ info.link_count }}" title="{{ info.link_count }} link{{ '' if info.link_count == 1 else 's' }}">{{ info.link_count }} ⇗</span>
            </span>
          </div>
        </a>
      {% endfor %}
    </div>
    <script>
      // Render Djot previews into rack units (compact, header-styled). See main.css .card__preview.
      document.querySelectorAll(".card__preview").forEach((el) => {
        const src = el.dataset.src || "";
        if (window.djot && src) {
          try {
            el.innerHTML = window.djot.renderHTML(window.djot.parse(src));
            // A strip has to be identifiable before it is read, so the note's
            // first block is promoted out of the preview to name the unit.
            const lead = el.querySelector("h1, h2, h3, h4, h5, h6, p, li");
            const leadText = lead && lead.textContent.trim();
            if (leadText) {
              const name = document.createElement("div");
              name.className = "card__name";
              name.textContent = leadText;
              el.parentElement.prepend(name);
              lead.remove();
            }
            // Demote rendered headings to styled divs so cards don't inject
            // page-level <h1>..<h6> into the document outline.
            el.querySelectorAll("h1, h2, h3, h4, h5, h6").forEach((h) => {
              const div = document.createElement("div");
              div.className = "card__h";
              div.textContent = h.textContent;
              h.replaceWith(div);
            });
            // Demote links to styled text: the whole card is one <a>, so nested
            // anchors are invalid HTML and would steal the card's click target.
            el.querySelectorAll("a").forEach((a) => {
              const span = document.createElement("span");
              span.className = "card__link";
              span.textContent = a.textContent;
              a.replaceWith(span);
            });
          } catch (err) {
            el.textContent = src;
          }
        }
      });
    </script>
  {% else %}
    <div class="empty-state-container">
      <div class="empty-state">
        <div class="empty-state__icon">📝</div>
        <h2 class="empty-state__title">No yaks found</h2>
        <p class="empty-state__message">
          {% if current_category %}
            No yaks in the "{{ current_category | title }}" category. Try a different category or create a new yak.
          {% else %}
            Get started by creating your first yak
          {% endif %}
        </p>
        <a href="/new" class="button button--primary" style="margin-top: var(--space-4);">Create New Yak</a>
      </div>
    </div>
  {% endif %}

  {% if total_pages > 1 %}
    <div class="pagination">
      {% if current_page > 1 %}
        <a href="/yaks?page={{ current_page - 1 }}&sort_by={{ sort_by }}{% if current_category %}&category={{ current_category }}{% endif %}" class="pagination__link">&laquo; Previous</a>
      {% endif %}

      {% for page_num in range([1, current_page - 2] | max, [total_pages + 1, current_page + 3] | min) %}
        <a class="pagination__link {% if page_num == current_page %}pagination__link--active{% endif %}" href="/yaks?page={{ page_num }}&sort_by={{ sort_by }}{% if current_category %}&category={{ current_category }}{% endif %}">{{ page_num }}</a>
      {% endfor %}

      {% if current_page < total_pages %}
        <a href="/yaks?page={{ current_page + 1 }}&sort_by={{ sort_by }}{% if current_category %}&category={{ current_category }}{% endif %}" class="pagination__link">Next &raquo;</a>
      {% endif %}
    </div>
  {% endif %}

  {# Creating a yak is one decision, so it is a modal over the rack rather than
     its own page. Rendered server-side and closed by a link, which means the
     whole flow works with scripting off; the only JS is the Escape key. #}
  {% if show_new %}
    <div class="modal" id="new-yak" role="dialog" aria-modal="true" aria-labelledby="new-yak-title">
      <a class="modal__scrim" href="/yaks" tabindex="-1" aria-hidden="true"></a>
      <div class="modal__panel">
        <div class="modal__head">
          <h2 class="modal__title" id="new-yak-title">New Yak</h2>
          <a class="modal__close" href="/yaks">Close</a>
        </div>

        {% if categories %}
          {# Its own form: a submit button in the same form as the text field
             would fire on Enter and file the note under the wrong category. #}
          <form method="post" action="/new" class="new-yak__form">
            <fieldset class="new-yak__group">
              <legend class="new-yak__legend">File it under</legend>
              <div class="new-yak__keys">
                {% for cat in categories | sort %}
                  <button type="submit" name="category" value="{{ cat }}" class="new-yak__key" style="--key-accent-color: {{ get_category_color(cat) }}">
                    <span class="new-yak__key-cap" aria-hidden="true"></span>{{ cat }}
                  </button>
                {% endfor %}
              </div>
            </fieldset>
          </form>
        {% endif %}

        <form method="post" action="/new" class="new-yak__form">
          <fieldset class="new-yak__group">
            <legend class="new-yak__legend">Or start a category</legend>
            <div class="new-yak__create">
              <label class="new-yak__label" for="new_category">New category name</label>
              <input type="text" id="new_category" name="new_category" class="form__input new-yak__input" placeholder="category name" autocomplete="off" maxlength="64" autofocus required>
              <button type="submit" class="button button--primary">Apply</button>
            </div>
          </fieldset>
        </form>
      </div>
    </div>
    <script>
      // Escape closes the modal. Everything else about it works without JS.
      document.addEventListener("keydown", (event) => {
        if (event.key === "Escape") { window.location.href = "/yaks"; }
      });
    </script>
  {% endif %}
{% endblock %}
