{% extends "base.html.jinja" %}

{% block title %}Yaks in {{ yak_dir_label }}{% endblock %}

{% block content %}
  <h1>Yaks in {{ yak_dir_label }}</h1>
  <p>Showing {{ files | length }} of {{ total_files }} yaks (Page {{ current_page }} of {{ total_pages }})</p>

  <div class="sort-controls">
    <span class="sort-controls__label">Sort by:</span>
    <a href="/files?sort_by=name{% if current_category %}&category={{ current_category }}{% endif %}" class="button button--sm {% if sort_by == 'name' %}button--primary{% endif %}">Name (Created At)</a>
    <a href="/files?sort_by=modified_date{% if current_category %}&category={{ current_category }}{% endif %}" class="button button--sm {% if sort_by == 'modified_date' %}button--primary{% endif %}">Modified Date</a>
  </div>

  {% if categories %}
    <div class="filter-controls">
      <span class="filter-controls__label">Filter by category:</span>
      <a href="/files?sort_by={{ sort_by }}" class="button button--sm {% if not current_category %}button--primary{% endif %}">All</a>
      {% for cat in categories | sort %}
        <a href="/files?sort_by={{ sort_by }}&category={{ cat }}" class="button button--sm {% if current_category == cat %}button--primary{% endif %}">{{ cat }}</a>
      {% endfor %}
    </div>
  {% endif %}

  <div class="cards">
    {% for info in files %}
      <a href="/edit?yak={{ info.path }}" class="card">
        <div class="card__body">
          <p>{{ info.preview }}{% if info.truncated %}...{% endif %}</p>
        </div>
        <div class="card__actions">
          <span class="badge">{{ info.last_modified }}</span>
          <span class="badge">{{ info.category }}</span>
        </div>
      </a>
    {% endfor %}
  </div>

  {% if total_pages > 1 %}
    <div class="pagination">
      {% if current_page > 1 %}
        <a href="/files?page={{ current_page - 1 }}&sort_by={{ sort_by }}{% if current_category %}&category={{ current_category }}{% endif %}" class="pagination__link">&laquo; Previous</a>
      {% endif %}

      {% for page_num in range([1, current_page - 2] | max, [total_pages + 1, current_page + 3] | min) %}
        <a class="pagination__link {% if page_num == current_page %}pagination__link--active{% endif %}" href="/files?page={{ page_num }}&sort_by={{ sort_by }}{% if current_category %}&category={{ current_category }}{% endif %}">{{ page_num }}</a>
      {% endfor %}

      {% if current_page < total_pages %}
        <a href="/files?page={{ current_page + 1 }}&sort_by={{ sort_by }}{% if current_category %}&category={{ current_category }}{% endif %}" class="pagination__link">Next &raquo;</a>
      {% endif %}
    </div>
  {% endif %}
{% endblock %}
