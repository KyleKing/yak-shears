{#def
from yak_shears._yak.filenames import FilenameReport
missing: list[tuple[str, str, str]]
orphans: list[tuple[str, str, int]]
referenced_count: int
file_count: int
filenames: FilenameReport
index_path: str
index_in_vault: bool
stray_index: str | None
-#}
{% extends "base.html.jinja" %}

{% block title %}Doctor{% endblock %}

{% block content %}
  <h1>Doctor</h1>
  <p class="page-info">
    {{ referenced_count }} referenced attachment{{ '' if referenced_count == 1 else 's' }},
    {{ file_count }} file{{ '' if file_count == 1 else 's' }} on disk,
    {{ missing | length }} missing, {{ orphans | length }} orphaned
  </p>

  <section class="doctor-section">
    <h2 class="doctor-section__title">Missing files</h2>
    {% if missing %}
      <p class="doctor-section__hint">Notes embed these, but the file is gone from <code>_attachments/</code>. Fix the link or re-upload.</p>
      <ul class="doctor-list">
        {% for category, filename, note in missing %}
          <li class="doctor-item doctor-item--missing">
            <code class="doctor-item__ref">/media/{{ category }}/{{ filename }}</code>
            <a class="doctor-item__note" href="/edit?yak={{ note }}">{{ note }}</a>
          </li>
        {% endfor %}
      </ul>
    {% else %}
      <p class="doctor-empty">All referenced media resolves.</p>
    {% endif %}
  </section>

  <section class="doctor-section">
    <h2 class="doctor-section__title">Orphaned files</h2>
    {% if orphans %}
      <p class="doctor-section__hint">No note references these; they are safe to delete to reclaim space.</p>
      <ul class="doctor-list">
        {% for category, filename, size_kb in orphans %}
          <li class="doctor-item doctor-item--orphan">
            <code class="doctor-item__ref">{{ category }}/{{ filename }}</code>
            <span class="doctor-item__size">{{ size_kb }} KB</span>
          </li>
        {% endfor %}
      </ul>
    {% else %}
      <p class="doctor-empty">No orphaned attachments.</p>
    {% endif %}
  </section>

  <section class="doctor-section">
    <h2 class="doctor-section__title">Filenames</h2>
    {% if filenames.renames %}
      <p class="doctor-section__hint">
        These predate the current naming scheme. Compact names sort below ISO ones within the same
        year, so a plain filename sort puts them in the wrong order. Renaming them keeps the listing
        sort a simple string compare. Wikilinks pointing at the old names are rewritten too.
      </p>
      <ul class="doctor-list">
        {% for rename in filenames.renames %}
          <li class="doctor-item doctor-item--rename">
            <code class="doctor-item__ref">{{ rename.old_path }}</code>
            <span class="doctor-item__note">&rarr; {{ rename.new_path }}</span>
          </li>
        {% endfor %}
      </ul>
      <form method="post" action="/doctor/fix-filenames" class="doctor-actions">
        <button type="submit" class="button button--primary">
          Rename {{ filenames.renames | length }} yak{{ '' if filenames.renames | length == 1 else 's' }}
        </button>
      </form>
    {% else %}
      <p class="doctor-empty">All {{ filenames.canonical | length }} timestamped yaks use the canonical name.</p>
    {% endif %}

    {% if filenames.blocked %}
      <p class="doctor-section__hint">
        Renaming these would collide with a name already in use, so they are left alone. Two notes
        claim the same instant; rename one by hand.
      </p>
      <ul class="doctor-list">
        {% for rename in filenames.blocked %}
          <li class="doctor-item doctor-item--missing">
            <code class="doctor-item__ref">{{ rename.old_path }}</code>
            <span class="doctor-item__note">would collide with {{ rename.new_path }}</span>
          </li>
        {% endfor %}
      </ul>
    {% endif %}

    {% if filenames.unparseable %}
      <details class="doctor-details">
        <summary>{{ filenames.unparseable | length }} yak{{ '' if filenames.unparseable | length == 1 else 's' }} not named after a timestamp</summary>
        <p class="doctor-section__hint">Left alone. A hand-written name is a choice, not a defect.</p>
        <ul class="doctor-list">
          {% for path in filenames.unparseable %}
            <li class="doctor-item"><code class="doctor-item__ref">{{ path }}</code></li>
          {% endfor %}
        </ul>
      </details>
    {% endif %}
  </section>

  <section class="doctor-section">
    <h2 class="doctor-section__title">Search index</h2>
    <p class="doctor-section__hint">Rebuildable from the vault. Nothing here is authoritative.</p>
    <ul class="doctor-list">
      <li class="doctor-item{% if index_in_vault %} doctor-item--missing{% endif %}">
        <code class="doctor-item__ref">{{ index_path }}</code>
        {% if index_in_vault %}
          <span class="doctor-item__note">inside the synced vault, which risks a torn copy (ADR 0010)</span>
        {% endif %}
      </li>
      {% if stray_index %}
        <li class="doctor-item doctor-item--orphan">
          <code class="doctor-item__ref">{{ stray_index }}</code>
          <span class="doctor-item__note">left by an older default; safe to delete, and worth adding to <code>.stignore</code></span>
        </li>
      {% endif %}
    </ul>
  </section>
{% endblock %}
