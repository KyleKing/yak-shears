<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}Yak Shears{% endblock %}</title>
    <link rel="stylesheet" href="/static/css/main.css">
    <script src="/static/js/htmx.min.js"></script>
    {% block extra_head %}{% endblock %}
  </head>
  <body class="layout">
    <header class="header">
      <div class="container">
        <div class="header__bar">
          <a href="/files" class="brand">
            <div class="brand__logo">YS</div>
            <span>Yak Shears</span>
          </a>
          <nav>
            <ul class="nav__list">
              <li><a href="/files" class="nav__link">Yaks</a></li>
            </ul>
          </nav>
        </div>
      </div>
    </header>

    <main class="layout__inner">
      <div class="container">
        {% block content %}{% endblock %}
      </div>
    </main>

    {% block scripts %}{% endblock %}
  </body>
</html>
