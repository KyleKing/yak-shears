{#def
-#}
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8">
    {# viewport-fit=cover lets the page paint under the iPhone notch/home indicator;
       every fixed bar below pads itself back out with env(safe-area-inset-*). #}
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
    <meta name="theme-color" content="#f5f3ef" media="(prefers-color-scheme: light)">
    <meta name="theme-color" content="#121212" media="(prefers-color-scheme: dark)">
    {# Without a manifest declaring display:standalone, iOS treats a homescreen
       launch as a plain bookmark and every navigation bounces to an in-app
       browser overlay. See adr/0009. #}
    <link rel="manifest" href="{{ static_url('manifest.webmanifest') }}">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
    <meta name="apple-mobile-web-app-title" content="Yak Shears">
    <link rel="icon" href="{{ static_url('icons/icon.svg') }}" type="image/svg+xml">
    <link rel="apple-touch-icon" href="{{ static_url('icons/apple-touch-icon.png') }}">
    <title>{% block title %}Yak Shears{% endblock %}</title>
    <link rel="stylesheet" href="{{ static_url('css/main.css') }}">
    <script src="{{ static_url('js/htmx.min.js') }}"></script>
    {% block extra_head %}{% endblock %}
  </head>
  <body class="layout" data-route="{{ current_route | default('') }}">
    <a href="#main-content" class="skip-link">Skip to main content</a>
    <header class="header" role="banner">
      <div class="container">
        <div class="header__bar">
          <a href="/yaks" class="brand" aria-label="Yak Shears home">
            <div class="brand__logo" aria-hidden="true">YS</div>
            <span class="brand__name">Yak Shears</span>
          </a>
          <div class="header__center">
            {% block header_center %}{% endblock %}
          </div>
          {# <details> rather than a JS toggle, for browser-native keyboard and
             ARIA behavior. It ships open and nav.js collapses it on phones,
             rather than the reverse: a closed <details> hides its content with
             content-visibility, which author CSS cannot force back open. Worst
             case without JS, the links stay listed instead of unreachable. #}
          <details class="nav" id="nav-menu" open>
            <summary class="nav__toggle" aria-label="Main menu" title="Main menu">
              <span class="nav__bars" aria-hidden="true"></span>
            </summary>
            <nav class="nav__panel" role="navigation" aria-label="Main navigation">
              <ul class="nav__list">
                <li><a href="/yaks" class="nav__link{% if current_route == 'yaks' %} nav__link--active{% endif %}" {% if current_route == 'yaks' %}aria-current="page"{% endif %}>Yaks</a></li>
                <li><a href="/search" class="nav__link{% if current_route == 'search' %} nav__link--active{% endif %}" {% if current_route == 'search' %}aria-current="page"{% endif %}>Search</a></li>
                <li><a href="/new" class="nav__link{% if current_route == 'new' %} nav__link--active{% endif %}" {% if current_route == 'new' %}aria-current="page"{% endif %}>New</a></li>
                <li><a href="/doctor" class="nav__link{% if current_route == 'doctor' %} nav__link--active{% endif %}" {% if current_route == 'doctor' %}aria-current="page"{% endif %}>Doctor</a></li>
              </ul>
            </nav>
          </details>
        </div>
      </div>
    </header>

    <main class="layout__inner" role="main" id="main-content">
      <div class="container">
        {% block content %}{% endblock %}
      </div>
    </main>

    <script src="{{ static_url('js/nav.js') }}"></script>
    {% block scripts %}{% endblock %}
  </body>
</html>
