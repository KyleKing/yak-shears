{#def
from yak_shears._templates import SearchResult
results: list[SearchResult]
query: str
-#}
<div class="search-content" id="search-results-container">
  {% if results %}
    <div class="search-results-sidebar">
      <div class="search-results-count">Found {{ results | length }} matches for "{{ query }}"</div>
      <div class="search-results-list" id="search-results-list">
        {% for result in results %}
          <div class="search-result" data-path="{{ result.path }}">
            <div class="search-result__first-line">{{ result.first_line }}</div>
            <div class="search-result__path">{{ result.path }}</div>
          </div>
        {% endfor %}
      </div>
    </div>

    <div class="search-preview" id="search-preview">
      <div class="search-preview-content" id="search-preview-content">
        <!-- Preview will be loaded here -->
      </div>
    </div>
  {% else %}
    <div class="search-empty">
      <p>No matches found for "{{ query }}"</p>
    </div>
  {% endif %}
</div>

<div class="search-preview-modal" id="search-preview-modal" style="display: none;">
  <div class="search-preview-modal__overlay"></div>
  <div class="search-preview-modal__content">
    <button class="search-preview-modal__close" id="search-preview-modal-close">&times;</button>
    <div class="search-preview-content" id="search-preview-modal-content">
      <!-- Modal preview will be loaded here -->
    </div>
  </div>
</div>
<script>
window.setupResults();

// Modal event listeners
document.getElementById("search-preview-modal-close")?.addEventListener("click", function() {
    const modal = document.getElementById("search-preview-modal");
    if (modal) {
        modal.style.display = "none";
        document.body.style.overflow = "";
    }
});
</script>
