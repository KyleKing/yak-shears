{#def
from yak_shears._templates import SearchResult
results: list[SearchResult]
query: str
-#}
<div class="search-content" id="search-results-container">
  {% if results %}
    <div class="search-results-sidebar">
      <div class="search-results-count">Found {{ results | length }} matches for "{{ query }}"</div>
      <div class="search-results-list" id="search-results-list">
        {% for result in results %}
          <div class="search-result" data-path="{{ result.path }}" role="listitem" tabindex="0">
            <div class="search-result__first-line">{{ result.first_line }}</div>
            <div class="search-result__preview">{{ result.preview }}</div>
          </div>
        {% endfor %}
      </div>
    </div>

    <div class="search-preview" id="search-preview">
      <div class="search-preview-content" id="search-preview-content">
        <!-- Preview will be loaded here -->
      </div>
    </div>
  {% else %}
    <div class="search-empty">
      <p>No matches found for "{{ query }}"</p>
    </div>
  {% endif %}
</div>

{# Keep identical to the copy in search.html.jinja #}
<div class="search-preview-modal" id="search-preview-modal" hidden role="dialog" aria-modal="true" aria-labelledby="search-preview-modal-title">
  <div class="search-preview-modal__overlay"></div>
  <div class="search-preview-modal__content">
    <div class="search-preview-modal__header">
      <span class="search-preview-modal__title" id="search-preview-modal-title">Preview</span>
      <button class="search-preview-modal__close" id="search-preview-modal-close" type="button" aria-label="Close preview">Close</button>
    </div>
    <div class="search-preview-content" id="search-preview-modal-content"></div>
  </div>
</div>
{# setupResults() binds the modal handlers idempotently; do not re-register them here #}
<script>
window.setupResults();
</script>
