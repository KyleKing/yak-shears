        <section class="metadata-section metadata-section--danger">
         <h3 class="metadata-section__title">
          Danger Zone
         </h3>
         <button class="button button--danger button--full" hx-confirm="Are you sure you want to delete this yak? This action cannot be undone." hx-post="/delete" hx-vals="js:{yak: 'test.dj'}">
          Delete Yak
         </button>
        </section>
       </aside>
      </div>
     </div>
    </main>
    <script>
     window.serverContent = "Test yak content";
    </script>
    <script src="/static/js/editor.js" type="module">
    </script>
   </body>
  </html>
  
