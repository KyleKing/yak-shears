# serializer version: 1
# name: test_edit_yak_get
  '''
  <main class="layout__inner" id="main-content" role="main">
   <div class="container">
    <div class="metadata-backdrop" id="metadata-backdrop">
    </div>
    <div class="editor-layout">
     <div class="editor-main">
      <div class="draft-toggle" hidden="" id="draft-toggle">
       <span class="draft-toggle__label">
        unsaved local changes
       </span>
       <button class="button button--sm active" id="draft-server-btn" type="button">
        server
       </button>
       <button class="button button--sm" id="draft-local-btn" type="button">
        local
       </button>
      </div>
      <div class="editor-container" id="editor-container">
       <form id="editor-form" method="post">
        <input name="yak" type="hidden" value="test.dj"/>
        <div class="editor" data-gramm="false" data-manual="">
        </div>
       </form>
       <div class="preview" id="preview">
        <div class="preview-content" id="preview-content">
        </div>
       </div>
      </div>
      <div class="editor__actions">
       <div class="container">
        <button class="button button--primary" hx-post="/edit" hx-swap="none" hx-vals='{"yak": "test.dj"}' id="save-btn">
         Save
        </button>
        <button aria-controls="metadata-panel" aria-expanded="false" aria-label="Toggle menu" class="button button--secondary" id="menu-btn" title="Toggle menu (⌘M)" type="button">
         Menu
        </button>
        <button aria-label="Attach photo or video" class="button button--secondary" id="upload-btn" title="Attach photo or video" type="button">
         ＋ Media
        </button>
        <input accept="image/*,video/*" hidden="" id="media-input" multiple="" type="file"/>
        <span class="editor__status" id="save-status">
        </span>
       </div>
      </div>
     </div>
     <aside class="metadata-panel" id="metadata-panel" style="--panel-accent: var(--color-border)">
      <div class="panel-titlebar">
       <span class="panel-titlebar__tab">
        <span aria-hidden="true" class="panel-titlebar__mark">
        </span>
        metadata
       </span>
       <span aria-hidden="true" class="panel-titlebar__tri">
        ▶
       </span>
       <button aria-label="Pin panel" aria-pressed="false" class="panel-pin" id="panel-pin-btn" type="button">
        <svg aria-hidden="true" fill="none" height="16" viewbox="0 0 16 16" width="16">
         <path d="M9.5 1L10.5 2L9 5.5L12 8.5L11 14L8 11L5 14L4 8.5L7 5.5L5.5 2L6.5 1L8 3L9.5 1Z" stroke="currentColor" stroke-linejoin="round" stroke-width="1.5">
         </path>
        </svg>
       </button>
      </div>
      <div class="panel-file">
       <span class="panel-file__name">
        test.dj
       </span>
       <span class="panel-file__category">
        Root
       </span>
      </div>
      <section class="metadata-section">
       <div class="metadata-section__label">
        view
       </div>
       <div class="view-toggle">
        <button class="button button--sm" data-view="editor" id="editor-only-btn">
         editor
        </button>
        <button class="button button--sm" data-view="side-by-side" id="side-by-side-btn">
         split
        </button>
        <button class="button button--sm" data-view="preview" id="preview-only-btn">
         preview
        </button>
       </div>
      </section>
      <section class="metadata-section">
       <div class="metadata-section__label">
        wrap
       </div>
       <button aria-pressed="false" class="button button--sm wrap-toggle" id="wrap-toggle" type="button">
        off
       </button>
      </section>
      <section class="metadata-section">
       <div class="metadata-section__label">
        links 0
       </div>
       <p class="metadata-empty">
        No backlinks
       </p>
      </section>
      <section class="metadata-section metadata-section--danger">
       <button class="button button--sm button--danger-ghost button--full" hx-confirm="Delete this yak? This cannot be undone." hx-post="/delete" hx-vals='{"yak": "test.dj"}'>
        rm test.dj
       </button>
      </section>
     </aside>
    </div>
   </div>
  </main>
  
  '''
# ---
# name: test_yaks_endpoint
  '''
  <main class="layout__inner" id="main-content" role="main">
   <div class="container">
    <h1>
     Yaks in ./yak_test_dir
    </h1>
    <p class="page-info">
     Showing 3 of 3 yaks (Page 1 of 1)
    </p>
    <div class="sort-controls">
     <span class="sort-controls__label">
      Sort by:
     </span>
     <a class="button button--sm button--primary" href="/yaks?sort_by=created_at">
      Created At
     </a>
     <a class="button button--sm" href="/yaks?sort_by=modified_date">
      Modified Date
     </a>
    </div>
    <div class="filter-controls">
     <span class="filter-controls__label">
      Filter by category:
     </span>
     <a class="button button--sm button--primary" href="/yaks?sort_by=created_at">
      All
     </a>
     <a class="button button--sm" href="/yaks?sort_by=created_at&amp;category=subdirectory-2">
      Subdirectory-2
     </a>
     <a class="button button--sm" href="/yaks?sort_by=created_at&amp;category=subdirectory-3">
      Subdirectory-3
     </a>
     <a class="button button--sm" href="/yaks?sort_by=created_at&amp;category=yak_test_dir">
      Yak_test_dir
     </a>
    </div>
    <div class="cards">
     <a class="card" href="/edit?yak=subdirectory-3/yak3.dj" style="--card-accent-color: hsl(261, 25%, 70%); --card-fill: 0.020">
      <div aria-hidden="true" class="card__meter" title="10 words">
      </div>
      <div class="card__body">
       <div class="card__preview" data-src="# Yak 3
  
  This is a test yak number 3">
        # Yak 3
  
  This is a test yak number 3
       </div>
      </div>
      <div class="card__meta">
       <span class="card__chip">
        Subdirectory-3
       </span>
       <span class="card__stats">
        <span class="card__stat card__stat--date" title="Last modified">
         2025-05-01
        </span>
        <span class="card__stat card__stat--links" title="0 links">
         ⇗ 0
        </span>
       </span>
      </div>
     </a>
     <a class="card" href="/edit?yak=subdirectory-2/yak2.dj" style="--card-accent-color: hsl(244, 40%, 55%); --card-fill: 0.008">
      <div aria-hidden="true" class="card__meter" title="4 words">
      </div>
      <div class="card__body">
       <div class="card__preview" data-src="# Yak 2
  
  &lt;https://www.ecosia.org/search?method=index&amp;q=yak&gt;">
        # Yak 2
  
  &lt;https://www.ecosia.org/search?method=index&amp;q=yak&gt;
       </div>
      </div>
      <div class="card__meta">
       <span class="card__chip">
        Subdirectory-2
       </span>
       <span class="card__stats">
        <span class="card__stat card__stat--date" title="Last modified">
         2025-05-01
        </span>
        <span class="card__stat card__stat--links" title="1 link">
         ⇗ 1
        </span>
       </span>
      </div>
     </a>
     <a class="card" href="/edit?yak=yak1.dj" style="--card-accent-color: hsl(160, 25%, 70%); --card-fill: 0.008">
      <div aria-hidden="true" class="card__meter" title="4 words">
      </div>
      <div class="card__body">
       <div class="card__preview" data-src="# Yak 1
  
  &lt;https://www.ecosia.org/search?method=index&amp;q=yak&gt;">
        # Yak 1
  
  &lt;https://www.ecosia.org/search?method=index&amp;q=yak&gt;
       </div>
      </div>
      <div class="card__meta">
       <span class="card__chip">
        Yak_test_dir
       </span>
       <span class="card__stats">
        <span class="card__stat card__stat--date" title="Last modified">
         2025-05-01
        </span>
        <span class="card__stat card__stat--links" title="1 link">
         ⇗ 1
        </span>
       </span>
      </div>
     </a>
    </div>
    <script>
     // Render Djot previews into cards (compact, header-styled). See main.css .card__preview.
        document.querySelectorAll(".card__preview").forEach((el) => {
          const src = el.dataset.src || "";
          if (window.djot && src) {
            try {
              el.innerHTML = window.djot.renderHTML(window.djot.parse(src));
              // Demote rendered headings to styled divs so cards don't inject
              // page-level <h1>..<h6> into the document outline.
              el.querySelectorAll("h1, h2, h3, h4, h5, h6").forEach((h) => {
                const div = document.createElement("div");
                div.className = "card__h";
                div.textContent = h.textContent;
                h.replaceWith(div);
              });
              // Demote links to styled text: the whole card is one <a>, so nested
              // anchors are invalid HTML and would steal the card's click target.
              el.querySelectorAll("a").forEach((a) => {
                const span = document.createElement("span");
                span.className = "card__link";
                span.textContent = a.textContent;
                a.replaceWith(span);
              });
            } catch (err) {
              el.textContent = src;
            }
          }
        });
    </script>
   </div>
  </main>
  
  '''
# ---
