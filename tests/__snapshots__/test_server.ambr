       </nav>
      </div>
     </div>
    </header>
    <main class="layout__inner" id="main-content" role="main">
     <div class="container">
      <div class="metadata-backdrop" id="metadata-backdrop">
      </div>
      <div class="editor-layout">
       <div class="editor-main">
        <div class="editor-container" id="editor-container">
         <form id="editor-form" method="post">
          <input name="yak" type="hidden" value="test.dj"/>
          <div class="editor" data-gramm="false" data-manual="">
          </div>
         </form>
         <div class="preview" id="preview">
          <div class="preview-content" id="preview-content">
          </div>
         </div>
        </div>
        <div class="editor__actions">
         <div class="container">
          <button class="button button--primary" hx-post="/edit" hx-swap="none" hx-vals="js:{content: getEditorContent(), yak: 'test.dj'}" id="save-btn">
           Save
          </button>
          <button aria-controls="metadata-panel" aria-expanded="false" aria-label="Toggle menu" class="button button--secondary" id="menu-btn" title="Toggle menu (⌘M)" type="button">
           Menu
          </button>
          <span class="editor__status" id="save-status">
          </span>
         </div>
        </div>
       </div>
       <aside class="metadata-panel" id="metadata-panel">
        <div class="panel-header">
         <div class="panel-header__info">
          <div class="panel-header__filename">
           test.dj
          </div>
          <div class="panel-header__category">
           Root
          </div>
         </div>
         <button aria-label="Pin panel" aria-pressed="false" class="panel-pin" id="panel-pin-btn" type="button">
          <svg aria-hidden="true" fill="none" height="16" viewbox="0 0 16 16" width="16">
           <path d="M9.5 1L10.5 2L9 5.5L12 8.5L11 14L8 11L5 14L4 8.5L7 5.5L5.5 2L6.5 1L8 3L9.5 1Z" stroke="currentColor" stroke-linejoin="round" stroke-width="1.5">
           </path>
          </svg>
         </button>
        </div>
        <section class="metadata-section">
         <h3 class="metadata-section__title">
          View Mode
         </h3>
         <div class="view-toggle">
          <button class="button button--sm" data-view="editor" id="editor-only-btn">
