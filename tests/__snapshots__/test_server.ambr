          wrap
         </div>
         <button aria-pressed="false" class="button button--sm wrap-toggle" id="wrap-toggle" type="button">
          off
         </button>
        </section>
        <section class="metadata-section">
         <div class="metadata-section__label">
          links 0
         </div>
         <p class="metadata-empty">
          No backlinks
         </p>
        </section>
        <section class="metadata-section metadata-section--danger">
         <button class="button button--sm button--danger-ghost button--full" hx-confirm="Delete this yak? This cannot be undone." hx-post="/delete" hx-vals='{"yak": "test.dj"}'>
          rm test.dj
         </button>
        </section>
       </aside>
      </div>
     </div>
    </main>
    <script>
     window.serverContent = "Test yak content";
    </script>
    <script src="/static/js/editor.js" type="module">
    </script>
   </body>
  </html>
  
  '''
# ---
# name: test_yaks_endpoint
  '''
  <!DOCTYPE html>
  <html lang="en">
   <head>
    <meta charset="utf-8"/>
    <meta content="width=device-width, initial-scale=1.0" name="viewport"/>
    <title>
     Yaks in ./yak_test_dir
    </title>
    <link href="/static/css/main.css" rel="stylesheet"/>
    <script src="/static/js/htmx.min.js">
    </script>
    <script src="/static/js/djot.min.js">
    </script>
   </head>
   <body class="layout" data-route="yaks">
    <a class="skip-link" href="#main-content">
     Skip to main content
    </a>
    <header class="header" role="banner">
     <div class="container">
      <div class="header__bar">
       <a aria-label="Yak Shears home" class="brand" href="/yaks">
        <div aria-hidden="true" class="brand__logo">
         YS
        </div>
        <span>
         Yak Shears
        </span>
       </a>
       <div class="header__center">
       </div>
       <nav aria-label="Main navigation" role="navigation">
        <ul class="nav__list">
         <li>
          <a aria-current="page" class="nav__link nav__link--active" href="/yaks">
           Yaks
          </a>
         </li>
         <li>
          <a class="nav__link" href="/search">
           Search
          </a>
         </li>
         <li>
          <a class="nav__link" href="/new">
           New
          </a>
         </li>
         <li>
          <a class="nav__link" href="/doctor">
           Doctor
          </a>
         </li>
        </ul>
       </nav>
      </div>
     </div>
    </header>
    <main class="layout__inner" id="main-content" role="main">
     <div class="container">
      <h1>
       Yaks in ./yak_test_dir
      </h1>
      <p class="page-info">
       Showing 3 of 3 yaks (Page 1 of 1)
      </p>
      <div class="sort-controls">
       <span class="sort-controls__label">
        Sort by:
       </span>
       <a class="button button--sm button--primary" href="/yaks?sort_by=created_at">
        Created At
       </a>
       <a class="button button--sm" href="/yaks?sort_by=modified_date">
        Modified Date
       </a>
      </div>
      <div class="filter-controls">
       <span class="filter-controls__label">
        Filter by category:
       </span>
       <a class="button button--sm button--primary" href="/yaks?sort_by=created_at">
        All
       </a>
       <a class="button button--sm" href="/yaks?sort_by=created_at&amp;category=subdirectory-2">
        Subdirectory-2
       </a>
       <a class="button button--sm" href="/yaks?sort_by=created_at&amp;category=subdirectory-3">
        Subdirectory-3
       </a>
       <a class="button button--sm" href="/yaks?sort_by=created_at&amp;category=yak_test_dir">
        Yak_test_dir
       </a>
      </div>
      <div class="cards">
       <a class="card" href="/edit?yak=subdirectory-3/yak3.dj" style="--card-accent-color: hsl(261, 25%, 70%); --card-fill: 0.020">
        <div aria-hidden="true" class="card__meter" title="10 words">
        </div>
        <div class="card__body">
         <div class="card__preview" data-src="# Yak 3
  
  This is a test yak number 3">
          # Yak 3
  
  This is a test yak number 3
         </div>
        </div>
        <div class="card__meta">
         <span class="card__chip">
          Subdirectory-3
         </span>
         <span class="card__stats">
          <span class="card__stat card__stat--date" title="Last modified">
           2025-05-01
          </span>
          <span class="card__stat card__stat--links" title="0 links">
           ⇗ 0
          </span>
         </span>
        </div>
       </a>
       <a class="card" href="/edit?yak=subdirectory-2/yak2.dj" style="--card-accent-color: hsl(244, 40%, 55%); --card-fill: 0.008">
        <div aria-hidden="true" class="card__meter" title="4 words">
        </div>
        <div class="card__body">
         <div class="card__preview" data-src="# Yak 2
  
  &lt;https://www.ecosia.org/search?method=index&amp;q=yak&gt;">
          # Yak 2
  
  &lt;https://www.ecosia.org/search?method=index&amp;q=yak&gt;
         </div>
        </div>
        <div class="card__meta">
         <span class="card__chip">
          Subdirectory-2
         </span>
         <span class="card__stats">
          <span class="card__stat card__stat--date" title="Last modified">
           2025-05-01
          </span>
          <span class="card__stat card__stat--links" title="1 link">
           ⇗ 1
          </span>
         </span>
        </div>
       </a>
       <a class="card" href="/edit?yak=yak1.dj" style="--card-accent-color: hsl(160, 25%, 70%); --card-fill: 0.008">
        <div aria-hidden="true" class="card__meter" title="4 words">
        </div>
        <div class="card__body">
         <div class="card__preview" data-src="# Yak 1
  
  &lt;https://www.ecosia.org/search?method=index&amp;q=yak&gt;">
          # Yak 1
  
  &lt;https://www.ecosia.org/search?method=index&amp;q=yak&gt;
         </div>
        </div>
        <div class="card__meta">
         <span class="card__chip">
          Yak_test_dir
         </span>
         <span class="card__stats">
          <span class="card__stat card__stat--date" title="Last modified">
           2025-05-01
          </span>
          <span class="card__stat card__stat--links" title="1 link">
           ⇗ 1
          </span>
         </span>
        </div>
       </a>
      </div>
      <script>
       // Render Djot previews into cards (compact, header-styled). See main.css .card__preview.
        document.querySelectorAll(".card__preview").forEach((el) => {
          const src = el.dataset.src || "";
          if (window.djot && src) {
            try {
              el.innerHTML = window.djot.renderHTML(window.djot.parse(src));
              // Demote rendered headings to styled divs so cards don't inject
              // page-level <h1>..<h6> into the document outline.
              el.querySelectorAll("h1, h2, h3, h4, h5, h6").forEach((h) => {
                const div = document.createElement("div");
                div.className = "card__h";
                div.textContent = h.textContent;
                h.replaceWith(div);
              });
              // Demote links to styled text: the whole card is one <a>, so nested
              // anchors are invalid HTML and would steal the card's click target.
              el.querySelectorAll("a").forEach((a) => {
                const span = document.createElement("span");
                span.className = "card__link";
                span.textContent = a.textContent;
                a.replaceWith(span);
              });
            } catch (err) {
              el.textContent = src;
            }
          }
        });
      </script>
     </div>
    </main>
   </body>
  </html>
  
  '''
# ---
